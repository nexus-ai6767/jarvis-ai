# Copy to your host's environment settings; do not commit real secrets.
PORT=3000
ADMIN_TOKEN=replace-with-a-random-secret-at-least-24-characters-long
# Absolute path to private persistent storage on your server:
DATA_DIR=/var/lib/astron-payment
PRODUCT_ZIP=/var/lib/astron-payment/astron-pro-windows.zip
# Exact public website origin, only needed if frontend and API use different origins:
SITE_ORIGIN=https://your-website.example
